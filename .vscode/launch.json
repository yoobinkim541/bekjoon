{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "디버그: 현재 파일",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "args": [],
